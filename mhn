    // ฟังก์ชันสร้างความเสียหายให้มอนสเตอร์
    function dealDamageToMonster(rawDmg, partMult = 1.0, sourceName = 'คุณ', isCrit = false) {
        const c = combatState;
        // หากมอนสเตอร์ติด Stun จะรับดาเมจแรงขึ้น 30%
        const stunBonusMult = c.stunTurns > 0 ? 1.3 : 1.0;
        const mitigated = Math.max(6, Math.round((rawDmg * stunBonusMult) - c.quest.def * 0.38));
        c.monsterHp = Math.max(0, c.monsterHp - mitigated);

        // แอนิเมชันสั่นการ์ดมอนสเตอร์
        const mCard = document.getElementById('monster-card');
        mCard.classList.remove('animate-shake');
        void mCard.offsetWidth;
        mCard.classList.add('animate-shake');

        spawnDamagePopup('monster-card', `${isCrit ? 'CRIT! ' : ''}-${mitigated}`, isCrit ? 'text-yellow-300' : 'text-red-400');

        // ตรวจสอบการเปลี่ยนเฟสของบอสใน Arena Mode (เมื่อ HP ต่ำกว่า 50%)
        if (c.isArena && c.phase === 1 && c.monsterHp > 0 && c.monsterHp <= c.monsterMaxHp * 0.5) {
            c.phase = 2;
            const phaseBadge = document.getElementById('combat-phase-badge');
            phaseBadge.textContent = 'Phase 2: AWAKENED / HELLFIRE!';
            phaseBadge.className = 'px-2.5 py-0.5 rounded text-xs font-kanit font-bold bg-red-900 text-amber-200 border border-amber-400 animate-pulse';
            appendCombatLog(`🌋 <strong>PHASE SHIFT!</strong> <strong>${c.quest.name}</strong> ปลดปล่อยพลังที่แท้จริงเข้าสู่เฟสที่ 2! พลังโจมตีเพิ่มขึ้นอย่างมหาศาล!`, 'text-rose-400');
        }

        // คำนวณ Part Break
        if (!c.partBroken) {
            c.partHp -= Math.round(mitigated * partMult);
            if (c.partHp <= 0) {
                c.partHp = 0;
                c.partBroken = true;
                c.stunTurns = Math.max(c.stunTurns, 1);
                if (c.isChargingUltimate) {
                    c.isChargingUltimate = false;
                    appendCombatLog(`💥 <strong>PART BROKEN & INTERRUPT!</strong> ชิ้นส่วนของ ${c.quest.name} แตกกระจายและขัดจังหวะท่าไม้ตายสำเร็จ!`, 'text-amber-300');
                } else {
                    appendCombatLog(`💥 <strong>PART BROKEN!</strong> ชิ้นส่วนของ ${c.quest.name} แตกกระจาย! มอนสเตอร์เสียหลักล้มลง!`, 'text-amber-400');
                }
            }
        }
        return mitigated;
    }

    // ฟังก์ชันขัดจังหวะมอนสเตอร์ (Interrupt / Stun Check)
    function tryInterruptMonster(successRate, methodLabel) {
        const c = combatState;
        if (Math.random() * 100 <= successRate) {
            c.stunTurns = 1;
            if (c.isChargingUltimate) {
                c.isChargingUltimate = false;
                appendCombatLog(`⚡ <strong>ขัดจังหวะสำเร็จ! (INTERRUPT!)</strong> ${methodLabel} หยุดท่าชาร์จ <strong>[${c.quest.ultimateName}]</strong> ของ ${c.quest.name} และทำให้ล้มลงมึนงง!`, 'text-yellow-300');
            } else {
                appendCombatLog(`💫 <strong>สตั๊นสำเร็จ!</strong> ${methodLabel} ทำให้ ${c.quest.name} มึนงงเสียหลัก 1 เทิร์น!`, 'text-yellow-300');
            }
            return true;
        } else {
            appendCombatLog(`❌ ${methodLabel} ไม่สามารถทำให้ ${c.quest.name} ชะงักได้!`, 'text-stone-400');
            return false;
        }
    }

    // คำสั่งของผู้เล่น: 1. โจมตีปกติ
    document.getElementById('act-attack').onclick = () => {
        if (!combatState || !combatState.isPlayerTurn) return;
        combatState.isPlayerTurn = false;
        combatState.stance = 'none';

        const stats = getPlayerStats();
        const isCrit = combatState.perfectEvadeBuff || (Math.random() < 0.22);
        const mult = isCrit ? 1.45 : (0.92 + Math.random() * 0.18);
        const dmg = dealDamageToMonster(stats.atk * mult, stats.weaponData.partBonus, gameState.name, isCrit);

        combatState.perfectEvadeBuff = false;
        const stamGain = combatState.playerStatuses.frostbite > 0 ? 8 : 15;
        gameState.stamina = Math.min(gameState.maxStamina, gameState.stamina + stamGain);
        SoundFX.play('attack');
        appendCombatLog(`🗡️ <strong>${gameState.name}</strong> โจมตีด้วย ${stats.weaponName} สร้างความเสียหาย <strong>${dmg}</strong> หน่วย!`, 'text-stone-100');

        checkCombatProgression();
    };

    // คำสั่งของผู้เล่น: 2. ท่าไม้ตายอาวุธ
    document.getElementById('act-skill').onclick = () => {
        if (!combatState || !combatState.isPlayerTurn) return;
        const stats = getPlayerStats();
        const wData = stats.weaponData;
        if (gameState.stamina < wData.stamCost) return;

        combatState.isPlayerTurn = false;
        combatState.stance = 'none';
        gameState.stamina -= wData.stamCost;

        const dmg = dealDamageToMonster(stats.atk * wData.skillMult, wData.partBonus * 1.3, gameState.name, true);
        combatState.perfectEvadeBuff = false;
        SoundFX.play('skill');
        appendCombatLog(`🔥 <strong>${gameState.name}</strong> ปลดปล่อยท่าไม้ตาย <strong>[${wData.skillName}]</strong> ฟาดฟันรุนแรง <strong>${dmg}</strong> ดาเมจ!`, 'text-amber-300');

        // โอกาส Stun พิเศษจากท่าไม้ตาย (เช่น Hammer / Charge Blade)
        if (wData.stunChance && Math.random() < wData.stunChance && combatState.monsterHp > 0) {
            tryInterruptMonster(100, `แรงกระแทกจาก ${wData.skillName}`);
        }

        checkCombatProgression();
    };

    // คำสั่งของผู้เล่น: 3. กระแทกขัดจังหวะ (Stun / Impact Strike)
    document.getElementById('act-stun').onclick = () => {
        if (!combatState || !combatState.isPlayerTurn) return;
        if (gameState.stamina < 20) return;

        combatState.isPlayerTurn = false;
        combatState.stance = 'none';
        gameState.stamina -= 20;

        const stats = getPlayerStats();
        const dmg = dealDamageToMonster(stats.atk * 0.65, stats.weaponData.partBonus * 1.4, gameState.name, false);
        SoundFX.play('attack');
        appendCombatLog(`🔨 <strong>${gameState.name}</strong> พุ่งกระแทกจุดอ่อนทำดาเมจ ${dmg} และพยายามขัดจังหวะ...`, 'text-yellow-200');

        if (combatState.monsterHp > 0) {
            tryInterruptMonster(stats.stunChance, 'การกระแทกจุดอ่อน');
        }

        checkCombatProgression();
    };

    // คำสั่งของผู้เล่น: 4. กลิ้งหลบ (Evade / Dodge %)
    document.getElementById('act-dodge').onclick = () => {
        if (!combatState || !combatState.isPlayerTurn) return;
        combatState.isPlayerTurn = false;
        combatState.stance = 'dodge';

        const stats = getPlayerStats();
        SoundFX.play('craft');
        appendCombatLog(`💨 <strong>${gameState.name}</strong> เตรียมพร้อมกลิ้งหลบการโจมตีในเทิร์นนี้ (โอกาสหลบสมบูรณ์ <strong>${stats.dodgeChance}%</strong>)!`, 'text-emerald-300');
        checkCombatProgression();
    };

    // คำสั่งของผู้เล่น: 5. ตั้งโล่ป้องกัน (Guard / Brace)
    document.getElementById('act-guard').onclick = () => {
        if (!combatState || !combatState.isPlayerTurn) return;
        combatState.isPlayerTurn = false;
        combatState.stance = 'guard';
        const stamGain = combatState.playerStatuses.frostbite > 0 ? 12 : 25;
        gameState.stamina = Math.min(gameState.maxStamina, gameState.stamina + stamGain);

        SoundFX.play('craft');
        appendCombatLog(`🛡️ <strong>${gameState.name}</strong> ตั้งโล่ป้องกันอย่างมั่นคง (ลดความเสียหาย 75% และฟื้นฟู +${stamGain} Stamina)`, 'text-sky-300');
        checkCombatProgression();
    };

    // คำสั่งของผู้เล่น: 6. เปิดลิ้นชักใช้ไอเทม
    document.getElementById('act-items-toggle').onclick = () => {
        const drawer = document.getElementById('combat-item-drawer');
        drawer.classList.toggle('hidden');
        renderCombatItemDrawer();
    };

    function renderCombatItemDrawer() {
        const drawer = document.getElementById('combat-item-drawer');
        drawer.innerHTML = '';
        const usable = [
            'Potion', 'Mega Potion', 'Max Potion', 'Ration',
            'Antidote', 'Nulberry', 'Flash Pod', 'Shock Trap',
            'Mega Barrel Bomb', 'Demondrug'
        ];

        usable.forEach(key => {
            const qty = gameState.inventory[key] || 0;
            const info = ITEMS_INFO[key];
            const btn = document.createElement('button');
            btn.disabled = qty <= 0;
            btn.className = 'btn-guild p-2 rounded-lg text-[11px] font-kanit flex items-center justify-between gap-1';
            btn.innerHTML = `<span class="truncate">${info.th.split(' ')[0]}</span><span class="text-amber-300 font-bold shrink-0">x${qty}</span>`;
            btn.onclick = () => useCombatItem(key);
            drawer.appendChild(btn);
        });
    }

    function useCombatItem(key) {
        if (!combatState || !combatState.isPlayerTurn) return;
        if ((gameState.inventory[key] || 0) <= 0) return;

        gameState.inventory[key]--;
        if (gameState.inventory[key] <= 0) delete gameState.inventory[key];

        document.getElementById('combat-item-drawer').classList.add('hidden');
        combatState.isPlayerTurn = false;
        combatState.stance = 'none';

        const stats = getPlayerStats();
        if (key === 'Potion') {
            gameState.hp = Math.min(stats.maxHp, gameState.hp + 50);
            SoundFX.play('heal');
            appendCombatLog(`🧪 <strong>${gameState.name}</strong> ดื่ม Potion ฟื้นฟู HP +50 หน่วย!`, 'text-emerald-400');
        } else if (key === 'Mega Potion') {
            gameState.hp = Math.min(stats.maxHp, gameState.hp + 120);
            SoundFX.play('heal');
            appendCombatLog(`🧪 <strong>${gameState.name}</strong> ดื่ม Mega Potion ฟื้นฟู HP +120 หน่วย!`, 'text-emerald-300');
        } else if (key === 'Max Potion') {
            gameState.hp = stats.maxHp;
            SoundFX.play('heal');
            appendCombatLog(`💖 <strong>${gameState.name}</strong> กิน Max Potion ฟื้นฟูพลังชีวิตเต็ม 100%!`, 'text-rose-300');
        } else if (key === 'Ration') {
            gameState.stamina = Math.min(gameState.maxStamina, gameState.stamina + 60);
            SoundFX.play('heal');
            appendCombatLog(`🍖 <strong>${gameState.name}</strong> กินเสบียงย่าง ฟื้นฟู Stamina +60!`, 'text-amber-300');
        } else if (key === 'Antidote') {
            combatState.playerStatuses.poison = 0;
            gameState.hp = Math.min(stats.maxHp, gameState.hp + 15);
            SoundFX.play('heal');
            appendCombatLog(`💊 <strong>${gameState.name}</strong> ดื่ม Antidote ล้างสถานะติดพิษหมดจด!`, 'text-purple-300');
        } else if (key === 'Nulberry') {
            combatState.playerStatuses.burn = 0;
            combatState.playerStatuses.frostbite = 0;
            SoundFX.play('heal');
            appendCombatLog(`🍒 <strong>${gameState.name}</strong> กินผล Nulberry ล้างสถานะธาตุทั้งหมด!`, 'text-cyan-300');
        } else if (key === 'Flash Pod') {
            SoundFX.play('skill');
            appendCombatLog(`☀️ <strong>${gameState.name}</strong> ยิงระเบิดแสง Flash Pod ใส่หน้า <strong>${combatState.quest.name}</strong>!`, 'text-yellow-300');
            tryInterruptMonster(90, 'แสงแฟลชเจิดจ้า');
        } else if (key === 'Shock Trap') {
            if (combatState.quest.isElder) {
                SoundFX.play('hurt');
                appendCombatLog(`⚠️ กับดักสายฟ้าใช้ไม่ได้ผลกับมังกรโบราณ <strong>${combatState.quest.name}</strong>!`, 'text-red-400');
            } else {
                SoundFX.play('skill');
                appendCombatLog(`⚡ <strong>${gameState.name}</strong> วางกับดักสายฟ้า Shock Trap!`, 'text-amber-300');
                tryInterruptMonster(100, 'กับดักสายฟ้า');
            }
        } else if (key === 'Mega Barrel Bomb') {
            const mult = combatState.stunTurns > 0 ? 2.0 : 1.0;
            const bombDmg = Math.round(220 * mult);
            combatState.monsterHp = Math.max(0, combatState.monsterHp - bombDmg);
            SoundFX.play('skill');
            spawnDamagePopup('monster-card', `BOOM! -${bombDmg}`, 'text-orange-400');
            appendCombatLog(`💣 <strong>${gameState.name}</strong> จุดระเบิด Mega Barrel Bomb! สร้างความเสียหาย <strong>${bombDmg}</strong> หน่วย${mult > 1 ? ' (โบนัสขณะมอนสเตอร์ล้ม!)' : ''}!`, 'text-orange-300');
        } else if (key === 'Demondrug') {
            combatState.demonDrug = true;
            SoundFX.play('heal');
            appendCombatLog(`🔥 <strong>${gameState.name}</strong> ดื่ม Demondrug! พลังโจมตีเพิ่มขึ้น 20% ตลอดการต่อสู้!`, 'text-orange-300');
        }

        checkCombatProgression();
    }

    // ตรวจสอบลำดับเทิร์น (ปาร์ตี้ AI -> Palico -> มอนสเตอร์)
    function checkCombatProgression() {
        updateCombatUI();

        if (combatState.monsterHp <= 0) {
            setTimeout(() => handleHuntVictory(), 600);
            return;
        }

        // เทิร์นของเพื่อนร่วมปาร์ตี้ (Multiplayer AI) และ Palico
        setTimeout(() => {
            if (!combatState) return;
            const stats = getPlayerStats();

            // 1. เพื่อนร่วมปาร์ตี้ AI ช่วยโจมตี/ฮีล
            if (combatState.isMultiplayer && combatState.monsterHp > 0) {
                combatState.party.forEach(ai => {
                    if (combatState.monsterHp <= 0) return;
                    if (ai.role === 'Support' && gameState.hp < stats.maxHp * 0.65 && Math.random() < 0.65) {
                        const healAmt = 38;
                        gameState.hp = Math.min(stats.maxHp, gameState.hp + healAmt);
                        appendCombatLog(`🎶 <strong>${ai.name}</strong> เป่าขลุ่ย Hunting Horn ฟื้นฟู HP ให้ทีม +${healAmt}!`, 'text-emerald-300');
                    } else {
                        const aiDmg = Math.round(stats.atk * (0.55 + Math.random() * 0.25));
                        const dealt = dealDamageToMonster(aiDmg, 0.8, ai.name, false);
                        appendCombatLog(`⚔️ <strong>${ai.name}</strong> (${ai.weapon}) เข้าประชิดโจมตีทำดาเมจ <strong>${dealt}</strong>!`, 'text-sky-300');
                    }
                });
            }

            // 2. คู่หูแมว Palico ช่วยเหลือ
            if (combatState.monsterHp > 0 && Math.random() < 0.48) {
                if (gameState.hp < stats.maxHp * 0.7) {
                    const vigorHeal = 32;
                    gameState.hp = Math.min(stats.maxHp, gameState.hp + vigorHeal);
                    appendCombatLog(`🐱 <strong>${gameState.palico}</strong> ส่งแมลงฮีล Vigorwasp ช่วยฟื้นฟู HP +${vigorHeal}!`, 'text-emerald-400');
                } else {
                    const catDmg = Math.round(15 + gameState.hr * 5);
                    combatState.monsterHp = Math.max(0, combatState.monsterHp - catDmg);
                    appendCombatLog(`🐾 <strong>${gameState.palico}</strong> ขว้างระเบิดเหมียวใส่มอนสเตอร์ทำดาเมจ <strong>${catDmg}</strong>!`, 'text-amber-200');
                }
            }

            updateCombatUI();

            if (combatState.monsterHp <= 0) {
                setTimeout(() => handleHuntVictory(), 600);
                return;
            }

            // 3. เทิร์นของมอนสเตอร์
            setTimeout(() => {
                if (!combatState) return;
                monsterTurn();
            }, 650);

        }, 550);
    }

    function monsterTurn() {
        const c = combatState;
        const stats = getPlayerStats();

        // คำนวณความเสียหายต่อเนื่องจากสถานะผิดปกติของผู้เล่น (Poison / Burn)
        if (c.playerStatuses.poison > 0) {
            const pDmg = Math.max(8, Math.round(stats.maxHp * 0.06));
            gameState.hp = Math.max(0, gameState.hp - pDmg);
            c.playerStatuses.poison--;
            appendCombatLog(`☠️ พิษแล่นเข้าสู่ร่างกาย! คุณเสีย HP <strong>${pDmg}</strong> หน่วย`, 'text-purple-400');
        }
        if (c.playerStatuses.burn > 0) {
            const bDmg = Math.max(10, Math.round(stats.maxHp * 0.07));
            gameState.hp = Math.max(0, gameState.hp - bDmg);
            c.playerStatuses.burn--;
            appendCombatLog(`🔥 เปลวไฟเผาไหม้ร่างกาย! คุณเสีย HP <strong>${bDmg}</strong> หน่วย`, 'text-orange-400');
        }
        if (c.playerStatuses.frostbite > 0) {
            c.playerStatuses.frostbite--;
        }

        if (gameState.hp <= 0) {
            handleHuntDefeat();
            return;
        }

        // ตรวจสอบว่ามอนสเตอร์ติด Stun อยู่หรือไม่
        if (c.stunTurns > 0) {
            c.stunTurns--;
            appendCombatLog(`💫 <strong>${c.quest.name}</strong> ยังคงมึนงงล้มลงกับพื้น ไม่สามารถโจมตีในเทิร์นนี้ได้!`, 'text-yellow-300');
        }
        // กรณีมอนสเตอร์ชาร์จท่าไม้ตายไว้จากเทิร์นที่แล้ว -> ปล่อยท่าไม้ตายรุนแรง!
        else if (c.isChargingUltimate) {
            c.isChargingUltimate = false;
            const phaseMult = c.phase === 2 ? 1.25 : 1.0;
            // หากทำลายชิ้นส่วนได้แล้ว ความแรงท่าไม้ตายลดลง 25%
            const partNerf = c.partBroken ? 0.75 : 1.0;
            const rawUlt = c.quest.atk * 2.15 * phaseMult * partNerf;
            const fullDmg = Math.max(15, Math.round(rawUlt - stats.def * 0.45));

            resolveIncomingAttack(fullDmg, `💥 <strong>${c.quest.name}</strong> ปลดปล่อยท่าไม้ตายทำลายล้าง <strong>[${c.quest.ultimateName}]</strong>!`, true);
        }
        // เทิร์นปกติของมอนสเตอร์: มีโอกาสเริ่มชาร์จท่าไม้ตาย (Telegraphed Attack) หรือโจมตีปกติ
        else {
            const chargeChance = c.isArena ? 0.38 : 0.28;
            if (Math.random() < chargeChance) {
                c.isChargingUltimate = true;
                SoundFX.play('skill');
                appendCombatLog(`⚠️ <strong>คำเตือนอันตราย!</strong> <strong>${c.quest.name}</strong> กำลังสูดลมหายใจและรวบรวมพลังมหาศาล เตรียมใช้ท่า <strong>[${c.quest.ultimateName}]</strong> ในเทิร์นหน้า!`, 'text-amber-300');
            } else {
                const phaseMult = c.phase === 2 ? 1.25 : 1.0;
                const isHeavy = Math.random() < 0.3;
                const rawAtk = c.quest.atk * (isHeavy ? 1.3 : 1.0) * phaseMult;
                const fullDmg = Math.max(5, Math.round(rawAtk - stats.def * 0.55));
                const atkDesc = isHeavy ? 'คำรามและพุ่งกระแทกอย่างดุเดือด!' : 'ตะปบและฟาดหางใส่คุณ!';

                resolveIncomingAttack(fullDmg, `🦖 <strong>${c.quest.name}</strong> ${atkDesc}`, isHeavy);
            }
        }

        c.stance = 'none';
        c.turn++;

        if (gameState.hp <= 0) {
            handleHuntDefeat();
            return;
        }

        c.isPlayerTurn = true;
        updateCombatUI();
    }

    // ประมวลผลความเสียหายที่เข้ามาตามท่าป้องกัน/หลบหลีกของผู้เล่น
    function resolveIncomingAttack(fullDmg, attackIntroMsg, canInflictStatus) {
        const c = combatState;
        const stats = getPlayerStats();

        // กรณีที่ 1: ผู้เล่นเลือก "กลิ้งหลบ (Evade)"
        if (c.stance === 'dodge') {
            const roll = Math.random() * 100;
            if (roll <= stats.dodgeChance) {
                c.perfectEvadeBuff = true;
                SoundFX.play('heal');
                appendCombatLog(`${attackIntroMsg} ➔ ✨ <strong>หลบหลีกสมบูรณ์! (PERFECT EVADE!)</strong> คุณกลิ้งหลบพ้นคมเขี้ยวได้อย่างหวุดหวิด (ได้รับ <strong>0 DMG</strong> และได้บัฟโจมตีสวนกลับ +35%!)`, 'text-emerald-300');
                return;
            } else {
                gameState.hp = Math.max(0, gameState.hp - fullDmg);
                SoundFX.play('hurt');
                appendCombatLog(`${attackIntroMsg} ➔ ❌ <strong>กลิ้งหลบพลาด!</strong> คุณเสียจังหวะและรับความเสียหายเต็มๆ <strong>${fullDmg}</strong> หน่วย!`, 'text-red-400');
                applyMonsterStatusIfAny(canInflictStatus);
                return;
            }
        }

        // กรณีที่ 2: ผู้เล่นเลือก "ตั้งโล่ป้องกัน (Guard)"
        if (c.stance === 'guard') {
            const guardedDmg = Math.max(2, Math.round(fullDmg * 0.25));
            gameState.hp = Math.max(0, gameState.hp - guardedDmg);
            SoundFX.play('craft');
            appendCombatLog(`${attackIntroMsg} ➔ 🛡️ <strong>ตั้งโล่ป้องกันสำเร็จ!</strong> ลดความเสียหายลง 75% เหลือเพียง <strong>${guardedDmg}</strong> หน่วย!`, 'text-sky-300');
            return;
        }

        // กรณีที่ 3: ไม่ได้ป้องกันหรือหลบหลีก รับดาเมจ 100%
        gameState.hp = Math.max(0, gameState.hp - fullDmg);
        SoundFX.play('hurt');
        appendCombatLog(`${attackIntroMsg} ➔ คุณได้รับความเสียหาย <strong>${fullDmg}</strong> หน่วย!`, 'text-red-400');
        applyMonsterStatusIfAny(canInflictStatus);
    }

    function applyMonsterStatusIfAny(canInflict) {
        const c = combatState;
        if (!canInflict || !c.quest.statusEffect || Math.random() > 0.45) return;

        const eff = c.quest.statusEffect;
        if (eff === 'poison' && c.playerStatuses.poison === 0) {
            c.playerStatuses.poison = 3;
            appendCombatLog(`☠️ คุณติดสถานะ <strong>พิษ (Poison)</strong> 3 เทิร์น! (ใช้ Antidote เพื่อรักษา)`, 'text-purple-300');
        } else if (eff === 'burn' && c.playerStatuses.burn === 0) {
            c.playerStatuses.burn = 3;
            appendCombatLog(`🔥 คุณติดสถานะ <strong>ไฟไหม้ (Burn)</strong> 3 เทิร์น! (ใช้ Nulberry เพื่อรักษา)`, 'text-orange-300');
        } else if (eff === 'frostbite' && c.playerStatuses.frostbite === 0) {
            c.playerStatuses.frostbite = 3;
            appendCombatLog(`❄️ คุณติดสถานะ <strong>น้ำแข็งเกาะ (Frostbite)</strong> การฟื้นฟู Stamina ลดลง!`, 'text-cyan-300');
        }
    }

    // จบเควสต์: ชนะ (QUEST CLEAR)
    function handleHuntVictory() {
        const c = combatState;
        const q = c.quest;
        SoundFX.play('victory');

        // คำนวณของรางวัล
        gameState.zenny += q.zenny;
        gameState.exp += q.exp;
        gameState.foodBuff = null; // หมดบัฟอาหารหลังจบเควสต์

        let lootSummary = [];
        q.drops.forEach(d => {
            if (Math.random() <= d.chance) {
                const count = Math.floor(Math.random() * (d.max - d.min + 1)) + d.min;
                gameState.inventory[d.item] = (gameState.inventory[d.item] || 0) + count;
                lootSummary.push(`${ITEMS_INFO[d.item].th.split(' ')[0]} x${count}`);
            }
        });

        // รางวัลเหรียญอารีน่าหากชนะใน Arena Mode
        if (c.isArena && q.arenaCoins) {
            gameState.inventory['Arena Coin'] = (gameState.inventory['Arena Coin'] || 0) + q.arenaCoins;
            lootSummary.push(`เหรียญอารีน่า x${q.arenaCoins}`);
        }

        // โบนัส Part Break
        if (c.partBroken && q.partDrop) {
            gameState.inventory[q.partDrop] = (gameState.inventory[q.partDrop] || 0) + 1;
            lootSummary.push(`[โบนัสชิ้นส่วนแตก] ${ITEMS_INFO[q.partDrop].th.split(' ')[0]} x1`);
        }

        // เช็คอัปเลเวล Hunter Rank (HR)
        let rankUpMsg = '';
        while (gameState.exp >= gameState.hr * 100) {
            gameState.exp -= gameState.hr * 100;
            gameState.hr++;
            rankUpMsg = ` 🎉 เลื่อนระดับเป็น Hunter Rank ${gameState.hr}!`;
        }

        showToast(`QUEST CLEAR! ล่า ${q.name} สำเร็จ! รับ ${q.zenny.toLocaleString()} z${rankUpMsg}`, 'success');
        addWorldChat('WORLD', `🏆 นักล่า "${gameState.name}" ${c.isMultiplayer ? 'และปาร์ตี้ ' : ''}พิชิต ${q.name} (${q.stars}) สำเร็จ!`, 'victory');

        if (lootSummary.length > 0) {
            showToast(`แล่ชิ้นส่วนได้รับ: ${lootSummary.join(', ')}`, 'info');
        }

        exitCombatToHub();
    }

    // จบเควสต์: พ่ายแพ้ (QUEST FAILED)
    function handleHuntDefeat() {
        SoundFX.play('hurt');
        gameState.hp = Math.round(getPlayerStats().maxHp * 0.5);
        gameState.stamina = gameState.maxStamina;
        gameState.foodBuff = null;
        const penalty = Math.min(gameState.zenny, 100);
        gameState.zenny -= penalty;

        showToast(`คุณหมดสติ! รถเข็นแมวพากลับหมู่บ้าน (เสียค่าธรรมเนียม ${penalty} z)`, 'danger');
        exitCombatToHub();
    }

    document.getElementById('btn-flee-quest').onclick = () => {
        showConfirmModal('ถอนตัวจากภารกิจ', 'คุณต้องการยกเลิกเควสต์และเดินทางกลับหมู่บ้าน Astera ใช่หรือไม่?', () => {
            showToast('ถอนตัวกลับหมู่บ้าน Astera เรียบร้อย', 'info');
            exitCombatToHub();
        });
    };

    function exitCombatToHub() {
        combatState = null;
        document.getElementById('combat-arena').classList.add('hidden');
        document.getElementById('hub-nav').classList.remove('hidden');

        // กลับไปที่แท็บกระดานเควสต์
        document.querySelectorAll('.nav-tab').forEach(b => b.classList.remove('border-amber-500', 'bg-amber-950/40', 'text-amber-300'));
        const questBtn = document.querySelector('.nav-tab[data-tab="quests"]');
        if (questBtn) questBtn.classList.add('border-amber-500', 'bg-amber-950/40', 'text-amber-300');

        document.querySelectorAll('.tab-content').forEach(s => s.classList.add('hidden'));
        document.getElementById('tab-quests').classList.remove('hidden');

        updateAllUI();
    }

    // ==================== 13. ระบบ WORLD CHAT จำลอง MMORPG ====================
    function addWorldChat(sender, text, type = 'normal') {
        const feed = document.getElementById('world-chat-feed');
        if (!feed) return;

        const row = document.createElement('div');
        const time = new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });

        if (type === 'system') {
            row.className = 'p-2 rounded bg-amber-950/30 border-l-2 border-amber-500 text-amber-200';
            row.innerHTML = `<span class="text-[10px] text-stone-500 mr-1">[${time}]</span><strong>[${sender}]</strong> ${text}`;
        } else if (type === 'victory') {
            row.className = 'p-2 rounded bg-emerald-950/30 border-l-2 border-emerald-500 text-emerald-200';
            row.innerHTML = `<span class="text-[10px] text-stone-500 mr-1">[${time}]</span>${text}`;
        } else {
            row.className = 'py-1 border-b border-stone-900 text-stone-300';
            row.innerHTML = `<span class="text-[10px] text-stone-500 mr-1">[${time}]</span><strong class="text-amber-400">${sender}:</strong> ${text}`;
        }

        feed.appendChild(row);
        if (feed.children.length > 40) {
            feed.removeChild(feed.firstChild);
        }
        feed.scrollTop = feed.scrollHeight;
    }

