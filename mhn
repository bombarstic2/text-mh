    };

    document.getElementById('btn-reset-save').onclick = () => {
        showConfirmModal('เริ่มเกมใหม่ (Reset Save)', 'ข้อมูลตัวละคร ไอเทม และเลเวล HR ทั้งหมดจะถูกลบถาวร ต้องการดำเนินการต่อหรือไม่?', () => {
            localStorage.removeItem('mh_frontier_save_v1');
            location.reload();
        });
    };

    // เริ่มต้นทำงานเมื่อโหลดหน้าเว็บเสร็จ
    window.onload = function() {
        initCharacterCreation();
        if (loadGame() && gameState && gameState.name) {
            enterMainGame();
        }
    };
    </script>
</body>
</html>
