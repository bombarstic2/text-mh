        hStatusBox.innerHTML = '';
        if (c.perfectEvadeBuff) {
            hStatusBox.innerHTML += `<span class="px-2 py-0.5 rounded bg-emerald-950 border border-emerald-400 text-emerald-300 text-[11px] font-kanit"><i class="fa-solid fa-sparkles mr-1"></i>Counter Crit (+35% ATK เทิร์นนี้)</span>`;
        }
