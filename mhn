    window.upgradeWeapon = function() {
        const wData = WEAPONS_DATA[gameState.weaponKey];
        const nextTier = wData.tiers[gameState.weaponTier + 1];
        if (!nextTier || gameState.zenny < nextTier.cost) return;

        for (const [mat, qty] of Object.entries(nextTier.req)) {
            if ((gameState.inventory[mat] || 0) < qty) return;
        }

        gameState.zenny -= nextTier.cost;
        for (const [mat, qty] of Object.entries(nextTier.req)) {
            gameState.inventory[mat] -= qty;
            if (gameState.inventory[mat] <= 0) delete gameState.inventory[mat];
        }

        gameState.weaponTier++;
        SoundFX.play('craft');
        showToast(`ตีบวกสำเร็จ! ได้รับ ${nextTier.name}`, 'success');
        updateAllUI();
    };

    window.craftArmor = function(armorId) {
        const armor = ARMORS_DATA.find(a => a.id === armorId);
        if (!armor || gameState.zenny < armor.cost) return;

        for (const [mat, qty] of Object.entries(armor.req)) {
            if ((gameState.inventory[mat] || 0) < qty) return;
        }

        gameState.zenny -= armor.cost;
        for (const [mat, qty] of Object.entries(armor.req)) {
            gameState.inventory[mat] -= qty;
            if (gameState.inventory[mat] <= 0) delete gameState.inventory[mat];
        }

        gameState.armorId = armor.id;
        const stats = getPlayerStats();
        gameState.hp = stats.maxHp;
        SoundFX.play('craft');
        showToast(`สร้างและสวมใส่ ${armor.name} เรียบร้อย!`, 'success');
        updateAllUI();
    };

