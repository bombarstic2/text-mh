<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monster Hunter: Frontier Chronicle - Text MMORPG</title>
    <!-- โหลด Tailwind CSS สำหรับจัด Layout และ Styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- โหลด Google Fonts ภาษาไทย (Kanit และ Sarabun) และ Cinzel สำหรับหัวข้อแฟนตาซี -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Kanit:wght@300;400;500;600;700&family=Sarabun:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- โหลด FontAwesome สำหรับไอคอน -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- โหลด Tone.js สำหรับสร้างเสียงเอฟเฟกต์แบบสังเคราะห์ (ไม่ต้องใช้ไฟล์เสียงภายนอก) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>

    <style>
        /* ตั้งค่าฟอนต์และธีมหลัก Dark Fantasy / Guild Parchment & Steel */
        body {
            font-family: 'Sarabun', sans-serif;
            background-color: #120e0b;
            color: #e8dcc8;
            background-image: radial-gradient(circle at 50% 0%, #2a1f18 0%, #120e0b 80%);
            min-height: 100vh;
            overflow-x: hidden;
        }

        h1, h2, h3, .font-kanit {
            font-family: 'Kanit', sans-serif;
        }

        .font-cinzel {
            font-family: 'Cinzel', serif;
        }

        /* ตกแต่ง Scrollbar ให้เข้ากับธีม */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #1a1410;
        }
        ::-webkit-scrollbar-thumb {
            background: #5c4530;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #8c6a4a;
        }

        /* การ์ดสไตล์เหล็กและหนังสัตว์ */
        .guild-card {
            background: linear-gradient(145deg, #1e1813 0%, #16110d 100%);
            border: 1px solid #4a3723;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(212, 175, 55, 0.15);
        }

        .guild-card-highlight {
            border-color: #b8860b;
            box-shadow: 0 0 15px rgba(184, 134, 11, 0.25);
        }

        /* ปุ่มสไตล์กิลด์ */
        .btn-guild {
            background: linear-gradient(to bottom, #3b2b1d, #241910);
            border: 1px solid #785a3c;
            color: #f3e5ab;
            transition: all 0.2s ease;
        }
        .btn-guild:hover:not(:disabled) {
            background: linear-gradient(to bottom, #4f3a27, #302216);
            border-color: #d4af37;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(212, 175, 55, 0.2);
        }
        .btn-guild:active:not(:disabled) {
            transform: translateY(1px);
        }
        .btn-guild:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

        .btn-danger {
            background: linear-gradient(to bottom, #7f1d1d, #450a0a);
            border: 1px solid #b91c1c;
            color: #fee2e2;
        }
        .btn-danger:hover:not(:disabled) {
            background: linear-gradient(to bottom, #991b1b, #5c0d0d);
            border-color: #ef4444;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
        }

        .btn-gold {
            background: linear-gradient(to bottom, #b45309, #78350f);
            border: 1px solid #f59e0b;
            color: #fef3c7;
        }
        .btn-gold:hover:not(:disabled) {
            background: linear-gradient(to bottom, #d97706, #92400e);
            border-color: #fcd34d;
            box-shadow: 0 4px 12px rgba(245, 158, 11, 0.35);
        }

        /* แอนิเมชันการต่อสู้ */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-8px) rotate(-1deg); }
            40% { transform: translateX(8px) rotate(1deg); }
            60% { transform: translateX(-6px); }
            80% { transform: translateX(6px); }
        }
        .animate-shake {
            animation: shake 0.4s cubic-bezier(.36,.07,.19,.97) both;
        }

        @keyframes pulseGold {
            0%, 100% { box-shadow: 0 0 5px rgba(212, 175, 55, 0.3); }
            50% { box-shadow: 0 0 18px rgba(212, 175, 55, 0.7); }
        }
        .animate-pulse-gold {
            animation: pulseGold 2s infinite;
        }

        @keyframes floatUp {
            0% { opacity: 1; transform: translateY(0) scale(1); }
            100% { opacity: 0; transform: translateY(-35px) scale(1.15); }
        }
        .damage-popup {
            position: absolute;
            pointer-events: none;
            animation: floatUp 0.9s ease-out forwards;
            font-family: 'Kanit', sans-serif;
            font-weight: 700;
            text-shadow: 0 2px 4px rgba(0,0,0,0.9);
            z-index: 50;
        }

        /* แถบเลือดและ Stamina */
        .bar-transition {
            transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }
    </style>
</head>
<body class="antialiased selection:bg-amber-700 selection:text-white">

    <!-- กล่องแจ้งเตือนแบบ Custom Toast (แทนการใช้ alert()) -->
    <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

    <!-- Modal ยืนยันต่างๆ (เช่น รีเซ็ตเซฟ) -->
    <div id="confirm-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
        <div class="guild-card rounded-xl max-w-md w-full p-6 border-amber-600/60">
            <h3 id="modal-title" class="text-xl font-bold text-amber-400 mb-2">ยืนยันการดำเนินการ</h3>
            <p id="modal-message" class="text-stone-300 text-sm mb-6">คุณแน่ใจหรือไม่?</p>
            <div class="flex justify-end gap-3">
                <button id="modal-cancel" class="btn-guild px-4 py-2 rounded-lg text-sm font-kanit">ยกเลิก</button>
                <button id="modal-confirm" class="btn-danger px-4 py-2 rounded-lg text-sm font-kanit">ยืนยัน</button>
            </div>
        </div>
    </div>

    <!-- ==================== 1. หน้าสร้างตัวละคร (CHARACTER CREATION) ==================== -->
    <div id="screen-create" class="min-h-screen flex items-center justify-center p-4 py-10">
        <div class="guild-card rounded-2xl max-w-3xl w-full p-6 sm:p-8 relative overflow-hidden">
            <!-- ลายประดับมุม -->
            <div class="absolute top-0 left-0 w-16 h-16 border-t-2 border-l-2 border-amber-500/40 rounded-tl-2xl pointer-events-none"></div>
            <div class="absolute bottom-0 right-0 w-16 h-16 border-b-2 border-r-2 border-amber-500/40 rounded-br-2xl pointer-events-none"></div>

            <div class="text-center mb-8">
                <div class="inline-block px-3 py-1 rounded-full bg-amber-950/80 border border-amber-600/40 text-amber-400 text-xs font-kanit tracking-wider mb-2">
                    GUILD REGISTRATION • ASTERA SERVER #01
                </div>
                <h1 class="text-3xl sm:text-4xl font-black text-amber-400 font-cinzel tracking-wide drop-shadow">
                    MONSTER HUNTER
                </h1>
                <p class="text-lg sm:text-xl font-kanit text-stone-300 mt-1">Frontier Chronicle</p>
                <p class="text-xs sm:text-sm text-stone-400 mt-2">ลงทะเบียนนักล่าหน้าใหม่เพื่อออกสำรวจโลกใหม่และพิชิตมอนสเตอร์ระดับตำนาน</p>
            </div>

            <form id="create-form" class="space-y-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- ชื่อ Hunter -->
                    <div>
                        <label class="block text-sm font-kanit text-amber-300 mb-1.5">
                            <i class="fa-solid fa-user-shield mr-1.5"></i>ชื่อนักล่า (Hunter Name)
                        </label>
                        <input type="text" id="input-hunter-name" required maxlength="18" placeholder="เช่น Arthur, Kaito, Somsak"
                            class="w-full bg-stone-900/90 border border-stone-700 focus:border-amber-500 rounded-lg px-4 py-2.5 text-stone-100 placeholder-stone-500 focus:outline-none transition">
                    </div>

                    <!-- ชื่อ Palico -->
                    <div>
                        <label class="block text-sm font-kanit text-amber-300 mb-1.5">
                            <i class="fa-solid fa-cat mr-1.5"></i>ชื่อคู่หูแมวเหมียว (Palico Name)
                        </label>
                        <input type="text" id="input-palico-name" required maxlength="16" placeholder="เช่น เจ้าส้ม, Mochi, Kuro"
                            class="w-full bg-stone-900/90 border border-stone-700 focus:border-amber-500 rounded-lg px-4 py-2.5 text-stone-100 placeholder-stone-500 focus:outline-none transition">
                    </div>
                </div>

                <!-- เลือกอาวุธเริ่มต้น -->
                <div>
                    <label class="block text-sm font-kanit text-amber-300 mb-2">
                        <i class="fa-solid fa-khanda mr-1.5"></i>เลือกอาวุธคู่ใจเริ่มต้น (Starting Weapon)
                    </label>
                    <div id="weapon-selector" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                        <!-- สร้างตัวเลือกอาวุธด้วย JS -->
                    </div>
                </div>

                <div class="pt-2 flex flex-col sm:flex-row gap-3 justify-between items-center border-t border-stone-800">
                    <button type="button" id="btn-random-char" class="btn-guild w-full sm:w-auto px-5 py-2.5 rounded-lg text-sm font-kanit flex items-center justify-center gap-2">
                        <i class="fa-solid fa-dice"></i> สุ่มข้อมูลนักล่า
                    </button>
                    <button type="submit" class="btn-gold w-full sm:w-auto px-8 py-3 rounded-lg text-base font-kanit font-semibold flex items-center justify-center gap-2 shadow-lg">
                        <i class="fa-solid fa-compass"></i> ออกเดินทางสู่ Astera
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ==================== 2. หน้าจอหลักเกม (MAIN GAME INTERFACE) ==================== -->
    <div id="screen-game" class="hidden min-h-screen flex flex-col max-w-7xl mx-auto p-2 sm:p-4 gap-3 sm:gap-4">

        <!-- TOP BAR: แถบสถานะตัวละคร (Player Status Header) -->
        <header class="guild-card rounded-xl p-3 sm:p-4">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
                <!-- ข้อมูลชื่อและแรงก์ -->
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl bg-gradient-to-br from-amber-700 to-stone-900 border border-amber-500/60 flex items-center justify-center text-2xl text-amber-300 shadow-inner shrink-0">
                        <i id="hud-weapon-icon" class="fa-solid fa-khanda"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2 flex-wrap">
                            <h2 id="hud-name" class="text-lg sm:text-xl font-bold font-kanit text-amber-300 leading-tight">Hunter</h2>
                            <span id="hud-hr" class="px-2 py-0.5 text-xs font-kanit font-semibold bg-amber-900/80 border border-amber-500/50 text-amber-200 rounded">HR 1</span>
                            <span id="hud-buff-badge" class="hidden px-2 py-0.5 text-xs font-kanit bg-emerald-950 border border-emerald-500/50 text-emerald-300 rounded">
                                <i class="fa-solid fa-utensils mr-1"></i><span id="hud-buff-text">Food Buff</span>
                            </span>
                        </div>
                        <div class="text-xs text-stone-400 mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-1">
                            <span><i class="fa-solid fa-cat text-amber-500 mr-1"></i>Palico: <strong id="hud-palico" class="text-stone-200">Mochi</strong></span>
                            <span><i class="fa-solid fa-coins text-yellow-400 mr-1"></i><strong id="hud-zenny" class="text-yellow-300">1,000</strong> z</span>
                            <span class="text-emerald-400"><i class="fa-solid fa-circle text-[8px] mr-1 animate-pulse"></i>Online: <span id="online-count">1,428</span></span>
                        </div>
                    </div>
                </div>

                <!-- หลอด HP / Stamina และค่าพลัง -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3 flex-1 lg:max-w-2xl">
                    <!-- HP Bar -->
                    <div class="bg-stone-950/80 p-2 rounded-lg border border-stone-800">
                        <div class="flex justify-between text-xs font-kanit mb-1">
                            <span class="text-emerald-400 font-semibold">HP</span>
                            <span id="hud-hp-text" class="text-stone-200">100 / 100</span>
                        </div>
                        <div class="w-full h-2 bg-stone-800 rounded-full overflow-hidden">
                            <div id="hud-hp-bar" class="h-full bg-gradient-to-r from-emerald-600 to-green-400 bar-transition" style="width: 100%;"></div>
                        </div>
                    </div>

                    <!-- Stamina Bar -->
                    <div class="bg-stone-950/80 p-2 rounded-lg border border-stone-800">
                        <div class="flex justify-between text-xs font-kanit mb-1">
                            <span class="text-amber-400 font-semibold">STAMINA</span>
                            <span id="hud-stam-text" class="text-stone-200">100 / 100</span>
                        </div>
                        <div class="w-full h-2 bg-stone-800 rounded-full overflow-hidden">
                            <div id="hud-stam-bar" class="h-full bg-gradient-to-r from-amber-600 to-yellow-400 bar-transition" style="width: 100%;"></div>
                        </div>
                    </div>

                    <!-- ATK / DEF -->
                    <div class="bg-stone-950/80 p-2 rounded-lg border border-stone-800 flex flex-col justify-center">
                        <div class="flex justify-between text-xs">
                            <span class="text-stone-400">พลังโจมตี:</span>
                            <span id="hud-atk" class="font-kanit font-bold text-red-400">25</span>
                        </div>
                        <div class="flex justify-between text-xs mt-0.5">
                            <span class="text-stone-400">พลังป้องกัน:</span>
                            <span id="hud-def" class="font-kanit font-bold text-sky-400">10</span>
                        </div>
                    </div>

                    <!-- อุปกรณ์สวมใส่ปัจจุบัน -->
                    <div class="bg-stone-950/80 p-2 rounded-lg border border-stone-800 flex flex-col justify-center text-xs">
                        <div class="truncate text-amber-200 font-medium" id="hud-weapon-name" title="อาวุธ">Iron Sword I</div>
                        <div class="truncate text-stone-400 mt-0.5" id="hud-armor-name" title="ชุดเกราะ">Leather Armor</div>
                    </div>
                </div>

                <!-- ปุ่มตั้งค่า / เสียง / รีเซ็ต -->
                <div class="flex items-center justify-end gap-2">
                    <button id="btn-toggle-sound" class="btn-guild p-2.5 rounded-lg text-xs" title="เปิด/ปิดเสียงเอฟเฟกต์">
                        <i id="sound-icon" class="fa-solid fa-volume-high"></i>
                    </button>
                    <button id="btn-reset-save" class="btn-guild p-2.5 rounded-lg text-xs text-red-300 hover:text-red-200" title="เริ่มเกมใหม่ (ล้างข้อมูล)">
                        <i class="fa-solid fa-rotate-right"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- MAIN WORKSPACE: แบ่งซ้าย (พื้นที่เล่นเกมหลัก) และ ขวา (World Chat / MMORPG Feed) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 sm:gap-4 flex-1">

            <!-- คอลัมน์ซ้าย (8 ส่วน): เมนูและหน้าจอแต่ละโหมด -->
            <main class="lg:col-span-8 flex flex-col gap-3">

                <!-- แถบเมนูนำทาง (ซ่อนตอนอยู่ในฉากต่อสู้) -->
                <nav id="hub-nav" class="grid grid-cols-2 sm:grid-cols-6 gap-2">
                    <button data-tab="quests" class="nav-tab btn-guild active-tab py-2.5 px-2 rounded-xl font-kanit text-xs sm:text-sm font-medium flex items-center justify-center gap-1.5 border-amber-500 bg-amber-950/40 text-amber-300">
                        <i class="fa-solid fa-scroll"></i> <span>เควสต์หลัก</span>
                    </button>
                    <button data-tab="arena" class="nav-tab btn-guild py-2.5 px-2 rounded-xl font-kanit text-xs sm:text-sm font-medium flex items-center justify-center gap-1.5 text-rose-300 border-rose-800/60">
                        <i class="fa-solid fa-skull"></i> <span>ลานประลอง</span>
                    </button>
                    <button data-tab="smithy" class="nav-tab btn-guild py-2.5 px-2 rounded-xl font-kanit text-xs sm:text-sm font-medium flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-hammer"></i> <span>โรงตีเหล็ก</span>
                    </button>
                    <button data-tab="canteen" class="nav-tab btn-guild py-2.5 px-2 rounded-xl font-kanit text-xs sm:text-sm font-medium flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-drumstick-bite"></i> <span>โรงอาหาร</span>
                    </button>
                    <button data-tab="expedition" class="nav-tab btn-guild py-2.5 px-2 rounded-xl font-kanit text-xs sm:text-sm font-medium flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-tree"></i> <span>ออกสำรวจ</span>
                    </button>
                    <button data-tab="inventory" class="nav-tab btn-guild py-2.5 px-2 rounded-xl font-kanit text-xs sm:text-sm font-medium flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-sack-xmark"></i> <span>กระเป๋า (<span id="inv-count">0</span>)</span>
                    </button>
                </nav>

                <!-- ==================== TAB 1: กระดานเควสต์ (QUEST BOARD) ==================== -->
                <section id="tab-quests" class="tab-content guild-card rounded-xl p-4 sm:p-5 flex-1">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 mb-4 border-b border-stone-800">
                        <div>
                            <h3 class="text-lg font-bold font-kanit text-amber-400 flex items-center gap-2">
                                <i class="fa-solid fa-dragon"></i> กระดานภารกิจล่ามอนสเตอร์ (Quest Board)
                            </h3>
                            <p class="text-xs text-stone-400">ล่ามอนสเตอร์ตามระดับ Hunter Rank (HR) เพื่อสะสมวัตถุดิบและเลื่อนขั้น</p>
                        </div>
                        <div class="text-xs bg-stone-900 px-3 py-1.5 rounded-lg border border-stone-700 text-stone-300">
                            EXP สะสม: <span id="quest-exp-text" class="text-amber-400 font-bold">0 / 100</span>
                        </div>
                    </div>

                    <div id="quest-list" class="grid grid-cols-1 md:grid-cols-2 gap-3.5 max-h-[540px] overflow-y-auto pr-1">
                        <!-- รายการเควสต์ถูกสร้างด้วย JS -->
                    </div>
                </section>

                <!-- ==================== TAB NEW: ลานประลองมรณะ (ELDER & APEX ARENA) ==================== -->
                <section id="tab-arena" class="tab-content hidden guild-card rounded-xl p-4 sm:p-5 flex-1 border-rose-900/60">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 mb-4 border-b border-rose-950">
                        <div>
                            <h3 class="text-lg font-bold font-kanit text-rose-400 flex items-center gap-2">
                                <i class="fa-solid fa-skull-crossbones"></i> ลานประลองมรณะ (Elder & Apex Arena)
                            </h3>
                            <p class="text-xs text-stone-400">ท้าทายมอนสเตอร์ระดับภัยพิบัติที่มีหลายเฟสและท่าไม้ตายทำลายล้าง รับเหรียญตราและวัตถุดิบระดับตำนาน!</p>
                        </div>
                        <div class="text-xs bg-rose-950/60 px-3 py-1.5 rounded-lg border border-rose-700/50 text-rose-200 font-kanit">
                            <i class="fa-solid fa-medal text-amber-400 mr-1"></i>เหรียญอารีน่า: <span id="arena-coin-text" class="text-amber-300 font-bold">0</span>
                        </div>
                    </div>

                    <div id="arena-list" class="grid grid-cols-1 gap-4 max-h-[540px] overflow-y-auto pr-1">
                        <!-- รายการบอสอารีน่าสร้างด้วย JS -->
                    </div>
                </section>

                <!-- ==================== TAB 2: โรงตีเหล็ก (SMITHY) ==================== -->
                <section id="tab-smithy" class="tab-content hidden guild-card rounded-xl p-4 sm:p-5 flex-1">
                    <div class="pb-3 mb-4 border-b border-stone-800">
                        <h3 class="text-lg font-bold font-kanit text-amber-400 flex items-center gap-2">
                            <i class="fa-solid fa-fire-burner"></i> โรงตีเหล็กแห่ง Astera (The Smithy)
                        </h3>
                        <p class="text-xs text-stone-400">ใช้วัตถุดิบจากมอนสเตอร์และลานประลองเพื่อตีบวกอาวุธระดับสูงสุดและสร้างชุดเกราะพร้อมสกิลติดตัว</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- อัปเกรดอาวุธ -->
                        <div class="bg-stone-950/60 border border-stone-800 rounded-xl p-4">
