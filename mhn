            hStatusBox.innerHTML += `<span class="px-2 py-0.5 rounded bg-orange-950 border border-orange-500 text-orange-300 text-[11px] font-kanit">Demondrug (+20% ATK)</span>`;
        }
        if (c.armorSkin) {
            hStatusBox.innerHTML += `<span class="px-2 py-0.5 rounded bg-sky-950 border border-sky-500 text-sky-300 text-[11px] font-kanit">Armorskin (+25% DEF)</span>`;
        }
        if (c.playerStatuses.poison > 0) {
            hStatusBox.innerHTML += `<span class="px-2 py-0.5 rounded bg-purple-950 border border-purple-500 text-purple-300 text-[11px] font-kanit"><i class="fa-solid fa-biohazard mr-1"></i>ติดพิษ (${c.playerStatuses.poison} เทิร์น)</span>`;
