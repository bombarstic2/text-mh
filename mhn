    // คำนวณค่าสถานะรวม (Base + Weapon + Armor + Food Buff + Combat Buffs)
    function getPlayerStats() {
        const wData = WEAPONS_DATA[gameState.weaponKey];
        const wTier = wData.tiers[gameState.weaponTier];
        const armor = ARMORS_DATA.find(a => a.id === gameState.armorId) || ARMORS_DATA[0];
        const buff = gameState.foodBuff || { atk: 0, def: 0, hp: 0 };

        const baseMaxHp = 100 + (gameState.hr - 1) * 12 + armor.hpBonus + buff.hp;
        let totalAtk = wTier.atk + buff.atk;
        let totalDef = wData.baseDef + armor.def + buff.def;

        // คำนวณบัฟชั่วคราวในฉากต่อสู้ (Demondrug / Armorskin / Perfect Evade Counter)
        if (combatState) {
            if (combatState.demonDrug) totalAtk = Math.round(totalAtk * 1.2);
            if (combatState.armorSkin) totalDef = Math.round(totalDef * 1.25);
            if (combatState.perfectEvadeBuff) totalAtk = Math.round(totalAtk * 1.35);
        }

        // โอกาสหลบหลีก (Base 55% + อาวุธ + ชุดเกราะ) จำกัดช่วง 20% - 92%
        const dodgeChance = Math.max(20, Math.min(92, 55 + (wData.dodgeBonus || 0) + (armor.dodgeBonus || 0)));
        // โอกาสสตั๊นขัดจังหวะ (Base 35% + อาวุธ + ชุดเกราะ) จำกัดช่วง 15% - 90%
        const stunChance = Math.max(15, Math.min(90, 35 + (wData.stunBonus || 0) + (armor.stunBonus || 0)));

        return {
            maxHp: baseMaxHp,
            atk: totalAtk,
            def: totalDef,
            dodgeChance: dodgeChance,
            stunChance: stunChance,
            weaponName: wTier.name,
            armorName: armor.name,
            armorSkill: armor.skillText,
            weaponData: wData
        };
    }

    // บันทึกและโหลดข้อมูลจาก LocalStorage
    function saveGame() {
        if (gameState) {
            localStorage.setItem('mh_frontier_save_v1', JSON.stringify(gameState));
        }
    }

    function loadGame() {
        const raw = localStorage.getItem('mh_frontier_save_v1');
        if (raw) {
            try {
                gameState = JSON.parse(raw);
                return true;
            } catch (e) {
                return false;
            }
        }
        return false;
    }

