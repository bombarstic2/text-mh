        const sampleMessages = [
            { user: 'Kaito_TH', msg: 'หาตี้ล่า Rathalos ครับ ขาดสายฮีล 1 ตำแหน่ง!' },
            { user: 'NongMay_SNS', msg: 'เพิ่งตีบวกดาบใหม่เสร็จ แรงขึ้นเยอะเลย~' },
            { user: 'ZeusBlade', msg: 'ใครฟาร์มทับทิม Rathalos Ruby ได้บ้าง ออกยากมากก' },
            { user: 'Bank_Hammer', msg: 'อย่าลืมกินข้าวที่โรงอาหารก่อนออกล่า Nergigante นะทุกคน' },
            { user: 'Luna_Felyne', msg: 'มีใครไปขุดแร่ Machalite ที่ Wildspire ไหมครับ' },
            { user: 'ArcheryPro', msg: 'ใช้ Flash Pod ตอน Rathalos บิน ช่วยได้เยอะเลย!' }
