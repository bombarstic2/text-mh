    // ==================== 12. ระบบการต่อสู้ (TACTICAL TURN-BASED COMBAT) ====================
    window.startHunt = function(questId, isMultiplayer, isArena = false) {
        const sourceList = isArena ? ARENA_BOSSES : QUESTS_DATA;
        const quest = sourceList.find(q => q.id === questId);
        if (!quest) return;

        // ตรวจสอบ HP ถ้าเหลือน้อยให้ฟื้นฟูขั้นต่ำก่อนออกล่า
        if (gameState.hp < 30) gameState.hp = 60;
        if (gameState.stamina < 40) gameState.stamina = 70;

        // สร้างสมาชิกปาร์ตี้ AI หากเลือก Multiplayer
        let party = [];
        if (isMultiplayer) {
            const shuffled = [...AI_HUNTERS].sort(() => 0.5 - Math.random());
            party = shuffled.slice(0, 2).map(ai => ({
                ...ai,
                hp: 100,
                maxHp: 100
            }));
