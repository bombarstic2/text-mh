        }
        if (c.partBroken) {
            statusBox.innerHTML += `<span class="px-2 py-0.5 rounded bg-amber-950 border border-amber-500 text-amber-300 text-[11px] font-kanit"><i class="fa-solid fa-bone mr-1"></i>ชิ้นส่วนแตกหัก (+โบนัสวัตถุดิบ)</span>`;
        }

        // ป้ายสถานะของ Hunter ในฉากต่อสู้
