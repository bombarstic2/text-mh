        addWorldChat('GUILD', 'เชื่อมต่อกับเซิร์ฟเวอร์ Astera TH-01 สำเร็จ', 'system');

        chatInterval = setInterval(() => {
            // อัปเดตจำนวนคนออนไลน์แบบสุ่มเล็กน้อย
            const baseOnline = 1420 + Math.floor(Math.random() * 35);
            const el = document.getElementById('online-count');
            if (el) el.textContent = baseOnline.toLocaleString();

            // สุ่มข้อความจากผู้เล่น AI
