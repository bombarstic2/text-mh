    // ==================== 2. ระบบเสียงสังเคราะห์ (TONE.JS SOUND FX) ====================
    const SoundFX = {
        enabled: true,
        synth: null,
        init() {
            if (!this.synth) {
                this.synth = new Tone.PolySynth(Tone.Synth).toDestination();
                this.synth.volume.value = -10;
            }
        },
        play(type) {
            if (!this.enabled) return;
            try {
                if (Tone.context.state !== 'running') Tone.start();
                this.init();
                const now = Tone.now();
                if (type === 'attack') {
                    this.synth.triggerAttackRelease(['C3', 'G2'], '16n', now);
                } else if (type === 'skill') {
                    this.synth.triggerAttackRelease(['A3', 'E4', 'A4'], '8n', now);
                } else if (type === 'heal') {
                    this.synth.triggerAttackRelease(['C5', 'E5', 'G5'], '8n', now);
                } else if (type === 'hurt') {
                    this.synth.triggerAttackRelease(['F2', 'B1'], '8n', now);
                } else if (type === 'victory') {
                    this.synth.triggerAttackRelease(['C4', 'E4', 'G4', 'C5'], '4n', now);
                } else if (type === 'craft') {
                    this.synth.triggerAttackRelease(['E5', 'B5'], '16n', now);
                }
            } catch (e) {
                // ป้องกัน error กรณีเบราว์เซอร์บล็อกเสียงก่อน user interaction
            }
        }
    };

