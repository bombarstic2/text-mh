        document.getElementById('act-guard').disabled = disabled;
        document.getElementById('act-dodge').disabled = disabled;
        document.getElementById('act-items-toggle').disabled = disabled;
        document.getElementById('act-skill').disabled = disabled || (gameState.stamina < wData.stamCost);
        document.getElementById('act-stun').disabled = disabled || (gameState.stamina < 20);
        document.getElementById('act-dodge-chance').textContent = `โอกาสหลบ ${stats.dodgeChance}% (0 DMG)`;
        document.getElementById('act-stun-chance').textContent = `ใช้ 20 Stam | สตั๊น ${stats.stunChance}%`;

