                const ai = AI_HUNTERS[Math.floor(Math.random() * AI_HUNTERS.length)];
                addWorldChat('WORLD', `⚔️ ปาร์ตี้ของ ${ai.name} ล่า Anjanath สำเร็จ!`, 'victory');
            }
        }, 7500);
    }

